{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OR-Space Explain rubric row",
  "type": "object",
  "required": [
    "workspace_id", "instance_id", "instance_number", "dimension", "question",
    "checklist", "expected_short_answer"
  ],
  "properties": {
    "workspace_id": {"type": "string", "pattern": "^or_space_[0-9]{3}_explain$"},
    "instance_id": {"type": "string", "pattern": "^OR_explain_[0-9]{3}$"},
    "instance_number": {"type": "integer", "minimum": 1, "maximum": 100},
    "source_revise_instance": {"type": "string"},
    "domain": {"type": "string"},
    "difficulty_level": {"type": "string"},
    "dimension": {"type": "string"},
    "multi_hop_path": {"type": "string"},
    "question": {"type": "string"},
    "expected_short_answer": {
      "type": "string",
      "description": "Concise audit aid; the checklist, not this field, is the authoritative scoring target."
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "checklist_type", "criterion"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^c[0-9]+$"},
          "checklist_type": {
            "type": "string",
            "enum": ["exact_match", "llm_boolean_judgment"]
          },
          "criterion": {"type": "string"},
          "target_entities": {"type": "array", "items": {"type": "string"}},
          "instruction_for_judge": {"type": "string"}
        }
      }
    }
  }
}
